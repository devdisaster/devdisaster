# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Verify everything with: ./setup/verify-keys.sh

# Devin — https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Context.dev — https://context.dev (dashboard → API keys)
CONTEXT_API_KEY=

# Stripe TEST-mode secret key (sk_test_...) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
