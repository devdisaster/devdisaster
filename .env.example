# Kevin has two kinds of configuration. Neither of them is this file — it is a
# reference, not something you copy to .env and expect to work.

# 1. Frontend / CLI values. Written automatically into .env.local by `npx convex dev`.
#    Do not hand-edit or commit them.
#      CONVEX_DEPLOYMENT=dev:your-deployment-name
#      VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# 2. Server-side secrets. These are read by Convex functions at runtime, so they
#    live in the Convex deployment environment — NOT in any local file:
#      npx convex env set ANTHROPIC_API_KEY    ...   # docs diagnosis (console.anthropic.com)
#      npx convex env set CONTEXT_API_KEY      ...   # docs monitoring (context.dev)
#      npx convex env set DEVIN_API_KEY        ...   # repair sessions (app.devin.ai)
#      npx convex env set SENTINEL_INGEST_TOKEN ...  # shared secret for the runtime-error ingest endpoint
#      npx convex env set CONTEXT_WEBHOOK_SECRET ... # verifies Context.dev monitor webhooks
#    List what is set with: npx convex env list

# ./setup/verify-keys.sh checks the three vendor keys with real calls. It reads
# them from your shell or from an optional local .env (gitignored, never committed).
